{
  "info": {
    "name": "EMS Event Service 테스트",
    "description": "event-service(8082)를 직접 호출하는 테스트. 위에서부터 순서대로 실행하세요 (Run collection). Gateway를 거쳐 테스트하려면 baseUrl을 http://localhost:8088/api 로 바꾸세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 행사 생성 (권한)",
      "item": [
        {
          "name": "1-1 행사 생성 - ADMIN → 201 (DRAFT, 링크 저장)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{adminId}}"
              },
              {
                "key": "X-User-Role",
                "value": "ADMIN"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud Native 세미나\",\n  \"description\": \"테스트 행사\",\n  \"capacity\": 100,\n  \"startsAt\": \"2026-11-01T05:00:00Z\",\n  \"endsAt\": \"2026-11-01T08:00:00Z\",\n  \"meetingUrl\": \"https://zoom.us/j/1234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"상태 코드 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"eventId\", b.id);",
                  "pm.test(\"새 행사는 DRAFT\", () => pm.expect(b.status).to.eql(\"DRAFT\"));",
                  "pm.test(\"화상 회의 링크 저장\", () => pm.expect(b.meetingUrl).to.eql(\"https://zoom.us/j/1234567890\"));",
                  "pm.test(\"만든 사람 저장\", () => pm.expect(b.createdBy).to.eql(Number(pm.collectionVariables.get(\"adminId\"))));"
                ]
              }
            }
          ]
        },
