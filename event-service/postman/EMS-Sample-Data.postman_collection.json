      "item": [
        {
          "name": "서버 살아 있나요? (ping)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{adminId}}"
              },
              {
                "key": "X-User-Role",
                "value": "ADMIN"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "ping"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
