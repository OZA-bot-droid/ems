POSTGRES_PASSWORD=change-me-local
APP_PORT=8088

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
# Member SMTP (required for password reset)
MAIL_USERNAME=your-smtp-address
MAIL_PASSWORD=replace-with-app-password

# Frontend / OAuth public origin (port must match APP_PORT)
FRONT_END_URL=http://localhost:8088
APP_PUBLIC_URL=http://localhost:8088
OAUTH_REDIRECT_BASE_URL=http://localhost:8088

# At least 32 random characters. Identical for Event and Interaction, NEVER commit the real value.
EMS_INTERNAL_TOKEN=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET

# Use true for HTTPS deployments; false for local HTTP
COOKIE_SECURE=false
